# ---- Servidor ----
# Puerto HTTP del servidor de juego (Express + Socket.IO)
PORT=3001
# Entorno: development | production | test
NODE_ENV=development
# Orígenes permitidos por CORS, separados por comas.
# En desarrollo el valor típico es la URL de Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL pública del cliente, usada para construir enlaces de invitacion
PUBLIC_WEB_URL=http://localhost:5173
# Base de datos (Prisma). El proveedor se deduce de la propia cadena:
#   file:./dev.db          -> SQLite, ideal en local, sin servicios externos
#   postgresql://user:...  -> PostgreSQL, necesario en produccion para que las
#                             marcas personales sobrevivan a los reinicios
DATABASE_URL="file:./dev.db"
# Segundos que una sala vacia sobrevive antes de eliminarse
ROOM_EMPTY_TTL_SECONDS=120
# Segundos de gracia para reconectar antes de expulsar a un jugador desconectado
RECONNECT_GRACE_SECONDS=90
# Rate limiting de mensajes de socket (mensajes por ventana)
SOCKET_RATE_LIMIT=60
SOCKET_RATE_WINDOW_MS=5000
# Tope de salas vivas a la vez en el proceso. Al alcanzarlo se rechazan las
# nuevas con un aviso, en lugar de agotar la memoria y tirar las partidas.
MAX_ROOMS=500
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# ---- Cliente (Vite) ----
# URL del servidor de sockets. Vacio = mismo origen (usa el proxy de Vite en dev)
VITE_SERVER_URL=http://localhost:3001
