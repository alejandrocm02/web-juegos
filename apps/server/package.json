{
  "name": "@arcade/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node scripts/run-prisma.mjs generate",
    "db:push": "node scripts/run-prisma.mjs db push",
    "db:studio": "node scripts/run-prisma.mjs studio"
  },
  "dependencies": {
    "@arcade/game-engine": "1.0.0",
    "@arcade/shared": "1.0.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "prisma": "^7.9.1",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  }
}
