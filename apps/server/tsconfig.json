{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // El cache incremental vive dentro de dist: al borrar dist se borra tambien
    // el cache, de modo que un checkout limpio siempre compila de verdad.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "composite": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../../packages/shared/tsconfig.json" },
    { "path": "../../packages/game-engine/tsconfig.json" }
  ]
}
