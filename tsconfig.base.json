{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    // Un acceso por indice devuelve `T | undefined`. Es la red que faltaba en la
    // fisica y en las tablas de juego, donde un indice fuera de rango no
    // reventaba: se propagaba como undefined hasta manifestarse lejos del
    // origen. Activarlo solo exigio corregir un punto en todo el monorepo.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
